{
  "name": "holydo-market",
  "version": "0.1.0",
  "private": true,
  "description": "HOLYDO MARKET — local services, humanly verified.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
