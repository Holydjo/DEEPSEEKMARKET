# Local SQLite database used by the v1 demo.
DATABASE_URL="file:./dev.db"

# Used for canonical URLs, the sitemap and social metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-side public URL used in transactional emails. Prefer this over the
# NEXT_PUBLIC value in production if the two can differ.
# SITE_URL="https://holydo.market"


# Email delivery for password reset and request notifications.
# Without a transport, messages stay QUEUED in /admin/emails.
# RESEND_API_KEY=""
# EMAIL_FROM="HOLYDO MARKET <hello@holydo.market>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="0"
